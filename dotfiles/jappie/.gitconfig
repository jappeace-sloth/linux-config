[push]
	default = simple
[user]
	email = jappieklooster@hotmail.com
	name = Jappie Klooster
	signingkey = 326504E64551A7FBD430E278FDA7B87746B63326
[color]
	ui = true
[alias]
	lol = log --oneline --graph --decorate
	st = status
	co = commit
	co = commit
	cm = commit
	gud = commit
[merge]
	tool = ediff
[mergetool "ediff"]
	cmd = emacsclient -c --eval \"(git-mergetool-emacsclient-ediff \\\"$LOCAL\\\" \\\"$REMOTE\\\" \\\"$BASE\\\" \\\"$MERGED\\\")\"
	trustExitCode = true
	keepBackup = false
[core]
	autocrlf = false
	# Deliberately no hooksPath here. A global one used to point at
	# ~/.config/git-hooks to refresh emacs dired listings on every
	# checkout/merge; it made emacs stall and was removed. Setting
	# core.hooksPath again means every repo-local hook has to be chained
	# by hand, because git then looks in that directory and nowhere else.
[commit]
	#gpgsign = true
